<nav class="site-nav">
  <a class="brand" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
  <div class="nav-socials">
    <a href="#" class="nav-email" data-email="{{ site.email }}" aria-label="Copy email address" title="Copy email address">
      <span class="icon-idle">{% include icons/mail.svg %}</span><span class="icon-copied">{% include icons/check.svg %}</span>
    </a>
    {%- if site.scholar_userid -%}
      <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" rel="noopener" aria-label="Google Scholar" title="Google Scholar">{% include icons/google-scholar.svg %}</a>
    {%- endif -%}
    {%- if site.github_username -%}
      <a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">{% include icons/github.svg %}</a>
    {%- endif -%}
    {%- if site.linkedin_username -%}
      <a href="https://linkedin.com/in/{{ site.linkedin_username }}" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">{% include icons/linkedin.svg %}</a>
    {%- endif -%}
    {%- if site.xiaohongshu_userid -%}
      <a href="https://www.xiaohongshu.com/user/profile/{{ site.xiaohongshu_userid }}" target="_blank" rel="noopener" aria-label="Xiaohongshu (RedNote)" title="Xiaohongshu (RedNote)">{% include icons/xiaohongshu.svg %}</a>
    {%- endif -%}
  </div>
</nav>
<script>
(function () {
  var btn = document.querySelector('.nav-email');
  if (!btn) return;
  var originalLabel = btn.getAttribute('aria-label');
  btn.addEventListener('click', function (e) {
    e.preventDefault();
    var email = btn.dataset.email;
    var done = function () {
      btn.classList.add('is-copied');
      btn.setAttribute('aria-label', 'Email copied');
      btn.title = 'Copied: ' + email;
      setTimeout(function () {
        btn.classList.remove('is-copied');
        btn.setAttribute('aria-label', originalLabel);
        btn.title = originalLabel;
      }, 1400);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(email).then(done, done);
    } else {
      var ta = document.createElement('textarea');
      ta.value = email; document.body.appendChild(ta);
      ta.select(); try { document.execCommand('copy'); } catch (err) {}
      document.body.removeChild(ta);
      done();
    }
  });
})();
</script>
