{%- comment -%}
  Layout used by jekyll-scholar to render ONE bibliography entry.
  Called via the `bibliography_template: bib` setting in _config.yml.
{%- endcomment -%}
<li class="pub-item">
  <span class="pub-year">{{ entry.year }}</span>
  <div class="pub-main">
    <div class="pub-title">{{ entry.title }}</div>
    <div class="pub-venue">
      {%- if entry.journal -%}<em>{{ entry.journal }}</em>
      {%- elsif entry.booktitle -%}<em>{{ entry.booktitle }}</em>
      {%- elsif entry.publisher -%}<em>{{ entry.publisher }}</em>
      {%- endif -%}
      {%- if entry.html or entry.pdf -%}<a class="link" href="{{ entry.html | default: entry.pdf }}">[html]</a>{%- endif -%}
      {%- if entry.code -%}<a class="link" href="{{ entry.code }}">[code]</a>{%- endif -%}
      {%- if entry.video -%}<a class="link" href="{{ entry.video }}">[video]</a>{%- endif -%}
      <a class="link" href="#bibtex-{{ entry.key }}" onclick="navigator.clipboard.writeText(document.getElementById('bibtex-{{ entry.key }}').textContent); this.textContent='[copied]'; return false;">[bibtex]</a>
    </div>
    <pre id="bibtex-{{ entry.key }}" class="pub-bibtex" hidden>{{ entry.bibtex }}</pre>
  </div>
</li>
